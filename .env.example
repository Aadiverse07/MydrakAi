# Copy to .env (never commit .env). Phase 0 needs no keys.
# Telegram bot token (BotFather). Required from bot phase onward.
TELEGRAM_BOT_TOKEN=
# Comma-separated Telegram chat IDs for the default restricted mode.
TELEGRAM_ALLOWED_CHAT_IDS=
# Public mode requires both --public-access and MYDRAK_PUBLIC=1.
MYDRAK_PUBLIC=0
# External service calls require explicit per-run authorization.
MYDRAK_LIVE=0
# Meta Model API key(s). Required from smoke-test phase onward.
META_API_KEY=
# Together AI key for the configured tier-1 host (placeholder only).
TOGETHER_API_KEY=
# local | production (see spec B10 / config).
COST_MODE=local
# public_test | private (private farmer photos: non-contributor variant only).
DATA_POLICY=private
# live | replay (replay serves cached responses, no network).
DEMO_MODE=replay
