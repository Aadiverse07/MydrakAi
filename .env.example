# Copy to .env (never commit .env). Phase 0 needs no keys.
# Telegram bot token (BotFather). Required from bot phase onward.
TELEGRAM_BOT_TOKEN=
# Meta Model API key(s). Required from smoke-test phase onward.
META_API_KEY=
# local | production (see spec B10 / config).
COST_MODE=local
# public_test | private (private farmer photos: non-contributor variant only).
DATA_POLICY=private
# live | replay (replay serves cached responses, no network).
DEMO_MODE=replay
